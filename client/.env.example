# Build-time configuration (baked into the bundle by Vite).
# Every value here can also be overridden at RUNTIME by /runtime-config.js,
# which lets one built image be pointed at any API without rebuilding.

# API base URL. Relative ("/api/v1") means "same origin" — use it when a
# reverse proxy / the bundled nginx forwards /api to the backend.
VITE_API_URL=/api/v1

# Canonical site URL used for SEO + Open Graph tags.
VITE_SITE_URL=http://localhost:5173

# Dev-server only: where `npm run dev` proxies /api and /uploads.
DEV_API_PROXY_TARGET=http://localhost:5000
