# Server — all variables are validated at boot by zod (src/config/env.ts)

NODE_ENV=development
PORT=5000
# 0.0.0.0 so the API is reachable from outside a container; use 127.0.0.1 to lock it to localhost
HOST=0.0.0.0

# MongoDB (local or Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/gogotactics

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_DAYS=7

# CORS allow-list for the frontend. CLIENT_URL is the primary origin;
# CLIENT_URLS adds extra origins as a comma-separated list.
CLIENT_URL=http://localhost:5173
# CLIENT_URLS=https://staging.example.com,https://example.com
# Escape hatch: accept any origin (credentials + wildcard is unsafe, dev only)
ALLOW_ANY_ORIGIN=false

# Reverse proxy / TLS termination
TRUST_PROXY=true
# Force the auth cookie's Secure flag. Leave unset to auto-enable it when
# NODE_ENV=production; set to false to run production mode over plain HTTP.
# COOKIE_SECURE=false

# Cloudinary (required for image uploads) — either a single URL...
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...or the three separate keys:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set to false to boot in production mode without Cloudinary (uploads then
# return "not configured" until the keys above are filled in). Default: true.
REQUIRE_CLOUDINARY=true

# Trending tuning (optional)
TRENDING_GRAVITY=1.5
