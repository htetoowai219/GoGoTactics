# Copy to .env to customise `docker compose up`. Every value already has a
# working default — .env is optional.

# ---- published ports (host side) ----
CLIENT_PORT=8080
SERVER_PORT=5000
MONGO_PORT=27017

# ---- api ----
# public origin of the client — used for CORS and for auth cookies
CLIENT_URL=http://localhost:8080
# extra allowed origins, comma-separated (e.g. https://staging.example.com)
CLIENT_URLS=
# canonical client URL used for SEO / Open Graph tags
SITE_URL=http://localhost:8080
NODE_ENV=production
# change this before exposing the API to the internet — the default below is a
# local-only placeholder that makes the API log a warning on boot
JWT_SECRET=local-only-change-me-before-deploying
JWT_EXPIRES_IN_DAYS=7
# false is required while serving over plain HTTP (no TLS in front)
COOKIE_SECURE=false
TRENDING_GRAVITY=1.5

# ---- database ----
MONGO_DB_NAME=gogotactics

# ---- image uploads (Cloudinary) ----
# Leave empty to boot without uploads: the API runs, uploads return
# "not configured" until these are set.
REQUIRE_CLOUDINARY=false
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
